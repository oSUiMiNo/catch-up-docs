{
  "name": "catch-up-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal private HTML library. PWA + Android TWA served from GitHub Pages.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=mobile-chromium",
    "test:e2e:docker": "docker run --rm -v \"$PWD:/work\" -w /work --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright -e CI=1 mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test",
    "setup": "node scripts/setup.mjs",
    "generate:vapid": "node scripts/generate-vapid.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:assetlinks": "node scripts/generate-assetlinks.mjs",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "verify:all": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run verify:secrets && npm run check:bundle-size",
    "android:image": "docker build -t catch-up-docs-android:latest ./android",
    "android:shell": "docker run --rm -it -v \"$PWD:/work\" catch-up-docs-android:latest bash"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
