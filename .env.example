# catch-up-docs 環境変数の例
#
# このファイルは値の「名前と意味」を示すためのもの。実際の値を書き込んだ .env を
# リポジトリへコミットしてはならない（.gitignore で除外済み）。
# 秘密情報は GitHub Actions Secrets へ登録する。登録手順は docs/SETUP.md を参照。

# ── ビルド設定（公開してよい） ───────────────────────────────
# GitHub Pages の配信パス。ユーザーサイト直下へ配信する場合は "/" にする。
BASE_PATH=/catch-up-docs/

# E2E テストで使うポート
E2E_PORT=4173


# ── このリポジトリの GitHub Actions Secrets に登録する値 ──────
# 値そのものをここへ書かないこと。名前の確認用。
#
#   ANDROID_KEYSTORE_BASE64    release APK 署名鍵を base64 化した文字列
#   ANDROID_KEYSTORE_PASSWORD  keystore のパスワード
#   ANDROID_KEY_ALIAS          署名鍵のエイリアス
#   ANDROID_KEY_PASSWORD       署名鍵のパスワード
#   PRIVATE_DOCS_REPO_NAME     秘密情報スキャナが公開資産から探す文書リポジトリ名
#
# 登録例（値は対話入力になり、シェル履歴へ残らない）:
#   gh secret set ANDROID_KEYSTORE_PASSWORD --repo <GITHUB_OWNER>/catch-up-docs


# ── 文書リポジトリ側の GitHub Actions Secrets に登録する値 ────
#   VAPID_PRIVATE_KEY   Web Push の署名に使う秘密鍵
#   VAPID_SUBJECT       mailto: 形式の連絡先
#
# VAPID public key は秘密ではないため public/runtime-config.json へ書く。


# ── ローカルで Android をビルドするときだけ使う ───────────────
# Bubblewrap の非対話ビルド用。シェルへ直接 export し、ファイルへ保存しないこと。
#   BUBBLEWRAP_KEYSTORE_PASSWORD
#   BUBBLEWRAP_KEY_PASSWORD
